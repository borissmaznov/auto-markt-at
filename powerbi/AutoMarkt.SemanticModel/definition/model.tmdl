model Model
	culture: de-DE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: de-AT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_registrations","dim_make","dim_year","dim_drive"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table fact_registrations
ref table dim_make
ref table dim_year
ref table dim_drive

ref cultureInfo de-DE

