table dim_make
	lineageTag: 151bc224-7694-5d0d-aa0b-a32a2a12a7db

	column make
		dataType: string
		isHidden
		lineageTag: 4fcce1aa-dc1d-58a3-b64c-5649ea991b64
		summarizeBy: none
		sourceColumn: make

		annotation SummarizationSetBy = User

	column brand
		dataType: string
		lineageTag: 52c14cfc-3b25-5852-aa83-ad6dc66f9f7e
		summarizeBy: none
		sourceColumn: brand

		annotation SummarizationSetBy = User

	column focus_brand
		dataType: string
		lineageTag: 45db54a0-b82a-54eb-8184-de1eb70ddaff
		summarizeBy: none
		sourceColumn: focus_brand

		annotation SummarizationSetBy = User

	partition dim_make = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Web.Contents("https://raw.githubusercontent.com/borissmaznov/auto-markt-at/main/powerbi/data/dim_make.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    MitKopf = Table.PromoteHeaders(Quelle, [PromoteAllScalars = true]),
				    Typen = Table.TransformColumnTypes(MitKopf, {{"make", type text}, {"brand", type text}, {"focus_brand", type text}}, "en-US")
				in
				    Typen

	annotation PBI_ResultType = Table

